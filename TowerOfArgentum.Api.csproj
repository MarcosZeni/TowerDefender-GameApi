<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TowerOfArgentum.Api</RootNamespace>
    <AssemblyName>TowerOfArgentum.Api</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Heredado del LoginServer sin cambiar el criterio: los contenedores .NET
         chicos vienen sin ICU y ahí revienta al arrancar cualquier comparación
         de strings que dependa de la cultura. Acá no hay ninguna — todo es
         ordinal y UTC — así que se apaga y no se paga. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Los números del juego: precios de planos y la fórmula de la billetera.

       ⚠ Van al lado del ejecutable o la API NO ARRANCA. El SDK Web ya incluye
       todo `**/*.json` como Content y hoy los copiaría igual; esto lo deja
       DECLARADO, porque depender de un glob implícito del SDK para que el
       servidor encuentre sus datos es una dependencia que nadie ve hasta que se
       rompe en un deploy.

       No están en appsettings.json a propósito: eso es config de despliegue y
       cambia por máquina; esto es balance, es igual en todas, y lleva el porqué
       de cada número comentado al lado. Ver Config\ServerData.cs. -->
  <ItemGroup>
    <Content Update="GameData\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="SimulationData\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />

    <!-- La simulación, para poder REVALIDAR una corrida re-simulándola.

         Sale de un paquete local y no de una referencia relativa al repo del
         cliente porque los tres repos son independientes: una referencia que
         salga del repo haría que clonar solo GameApi diera un proyecto que no
         compila. Ver nuget.config.

         ⚠ Si falla la restauración, correr una vez, en el repo del cliente:
             cd Client/Simulation
             dotnet pack -c Release -->
    <!-- ⚠ Este número tiene que seguir al <Version> del csproj de la simulación.
         Que se separen no rompe la compilación: el servidor revalida con una
         simulación VIEJA y le da otro resultado que el cliente, o sea que acusa
         de trampa a quien no hizo nada. Pasó: quedó en 0.1.0 del 2026-09-01
         mientras el cliente cambiaba Fuse, el ritmo de áreas y las sinergias. -->
    <PackageReference Include="TowerOfArgentum.Simulation" Version="0.2.0" />
  </ItemGroup>

  <!-- ⚠ Lo que NO se referencia, y es deliberado (CLAUDE.md):
       · MaxMind.GeoIP2 — el LoginServer geolocaliza intentos; acá no hace falta.
       · Nada de sockets ni del protocolo binario de AO. Todo es HTTP/JSON. -->

</Project>
