<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TowerOfArgentum.Api</RootNamespace>
    <AssemblyName>TowerOfArgentum.Api</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Heredado del LoginServer sin cambiar el criterio: los contenedores .NET
         chicos vienen sin ICU y ahí revienta al arrancar cualquier comparación
         de strings que dependa de la cultura. Acá no hay ninguna — todo es
         ordinal y UTC — así que se apaga y no se paga. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />

    <!-- La simulación, para poder REVALIDAR una corrida re-simulándola.

         Sale de un paquete local y no de una referencia relativa al repo del
         cliente porque los tres repos son independientes: una referencia que
         salga del repo haría que clonar solo GameApi diera un proyecto que no
         compila. Ver nuget.config.

         ⚠ Si falla la restauración, correr una vez, en el repo del cliente:
             cd Client/Simulacion
             dotnet pack -c Release -->
    <PackageReference Include="TowerOfArgentum.Simulacion" Version="0.1.0" />
  </ItemGroup>

  <!-- ⚠ Lo que NO se referencia, y es deliberado (CLAUDE.md):
       · MaxMind.GeoIP2 — el LoginServer geolocaliza intentos; acá no hace falta.
       · Nada de sockets ni del protocolo binario de AO. Todo es HTTP/JSON. -->

</Project>
